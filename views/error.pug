include mixins/navbar-auth.pug
include mixins/navbar-no-auth.pug
include mixins/footer.pug

doctype html
html(lang="es")

    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")

        title Error #{codigoError} - Fotaza

        link(rel='stylesheet', href='/css/bootstrap.min.css')

        style.
            body{
                background-color: #f3f3f3;
            }

            .error-container{
                min-height: calc(100vh - 180px);
            }

            .error-code{
                font-size: 8rem;
                font-weight: 800;
                color: #212529;
                line-height: 1;
            }

            .error-message{
                font-size: 1.25rem;
                color: #6c757d;
            }

            .error-card{
                max-width: 700px;

                border: none;
                border-radius: 24px;

                background: white;

                box-shadow:
                    0 10px 40px rgba(0,0,0,.08);
            }
    body

        if autenticado
            +navbar-auth(avatar)
        else
            +navbar-no-auth()

        .container.error-container.d-flex.align-items-center.justify-content-center

            .card.error-card.p-5.text-center

                h1.error-code.mb-3
                    = codigoError

                p.error-message.mb-4
                    = mensaje

        script(src='/script/bootstrap.bundle.min.js')