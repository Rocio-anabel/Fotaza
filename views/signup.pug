include mixins/navbar-no-auth.pug
include mixins/footer.pug

doctype html
html 
    head 
        title Registro - Fotaza
        link(rel='stylesheet', href='/css/bootstrap.min.css')
        style.
            body{
                background-color: #f3f3f3;
                min-height: 100vh;
            }

            .register-card{
                max-width: 750px;
                border-radius: 24px;
                border: none;
            }

            .form-control,
            .form-select{
                border-radius: 12px;
                padding: 12px;
            }

            .form-control:focus,
            .form-select:focus{
                box-shadow: none;
                border-color: #212529;
            }

            .register-btn{
                background-color: #212529;
                color: white;
                border-radius: 12px;
                padding: 12px;
                transition: .2s;
            }

            .register-btn:hover{
                background-color: black;
                color: white;
            }

            .logo-title{
                font-size: 3rem;
                font-weight: 800;
            }
    body 
        +navbar-no-auth()
        .container-fluid 
            .card.register-card.shadow.mx-auto.p-4.p-md-5

                .text-center.mb-5
                  h1.logo-title Regístrate
                  

                form(action="/auth/signup" method="POST" enctype="multipart/form-data" novalidate class="needs-validation")

                  .row.g-4

                    // Nombre
                    .col-md-6
                      label.form-label Nombre
                      input.form-control(
                        type="text"
                        name="nombre"
                        value= data.nombre || ''
                        class= errors.nombre ? 'is-invalid' : ''
                        placeholder="Tu nombre"
                        required
                      )
                      if errors.nombre
                        .invalid-feedback= errors.nombre[0]

                    // Apellido
                    .col-md-6
                      label.form-label Apellido
                      input.form-control(
                        type="text"
                        name="apellido"
                        value= data.apellido || ''
                        class= errors.apellido ? 'is-invalid' : ''
                        placeholder="Tu apellido"
                        required
                      )
                      if errors.apellido 
                        .invalid-feedback= errors.apellido[0]

                    // Email
                    .col-12
                      label.form-label Correo electrónico
                      input.form-control(
                        type="email"
                        name="email"
                        value= data.email || ''
                        class= errors.email ? 'is-invalid' : ''
                        placeholder="ejemplo@email.com"
                        required
                      )
                      if errors.email
                        .invalid-feedback= errors.email[0]

                    // Contraseña
                    .col-12
                      label.form-label Contraseña
                      input.form-control(
                        type="password"
                        name="password"
                        value= data.password || ''
                        class= errors.password ? 'is-invalid' : ''
                        placeholder="••••••••"
                        required
                      )
                      if errors.password 
                        .invalid-feedback= errors.password[0]
                    // Fecha nacimiento
                    .col-md-6
                      label.form-label Fecha de nacimiento
                      input.form-control(
                        type="date"
                        name="fechaNacimiento"
                        class= errors.fechaNacimiento ? 'is-invalid' : ''
                        required
                      )
                      if errors.fechaNacimiento 
                        .invalid-feedback= errors.fechaNacimiento[0]

                    // Sexo
                    .col-md-6
                      label.form-label Sexo
                      select.form-select(name="sexo" class= errors.sexo ? 'is-invalid' : '' required)
                        option(value="" selected disabled) Seleccionar
                        option(value="femenino") Femenino
                        option(value="masculino") Masculino
                        option(value="otro") Otro
                        option(value="prefiero-no-decir") Prefiero no decir
                      if errors.sexo 
                        .invalid-feedback= errors.sexo[0]

                    // Bio
                    .col-12
                      label.form-label Bio (opcional)
                      textarea.form-control(
                        name="bio"
                        rows="4"
                        placeholder="Cuéntanos un poco sobre ti..."
                      )

                    // Avatar
                    .col-12
                      label.form-label Foto de avatar (opcional)
                      input.form-control(
                        type="file"
                        name="avatar"
                        accept="image/*"
                      )

                    // Botón
                    .col-12.mt-4
                      button.btn.register-btn.w-100(type="submit")
                        | Crear cuenta
        +footer()
    script(src='/script/bootstrap.bundle.min.js')
    script.
      const form = document.querySelector('.needs-validation')
        form.addEventListener('submit', e => {
          form.classList.add('was-validated')
        })