include mixins/navbar-no-auth.pug
include mixins/footer.pug

doctype html
html 
    head 
        title Iniciar sesión - Fotaza
        link(rel='stylesheet', href='/css/bootstrap.min.css')
        style.
            body{
                background-color: #efefef;
                min-height: 100vh;
            }
            .login-card{
                max-width: 1000px;
                border: none;
                border-radius: 28px;
                overflow: hidden;
                background-color: white;
                box-shadow: 0 10px 40px rgba(0,0,0,.08);
            }
            .form-side{
                padding: 40px 60px 60px 60px;
                display: flex;
                flex-direction: column;
                justify-content: flex-start;
            }

            .login-image{
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
            .form-wrapper{
                width: 100%;
                max-width: 500px;
                padding: 40px;
            }
            

            .login-title{
                font-size: 3rem;
                font-weight: 800;
            }

            .form-control{
                border-radius: 12px;
                padding: 12px;
            }

            .form-control:focus{
                box-shadow: none;
                border-color: #212529;
            }

            .login-btn{
                background-color: #212529;
                color: white;
                border-radius: 12px;
                padding: 12px;
                transition: .2s;
            }

            .login-btn:hover{
                background-color: black;
                color: white;
            }
    body 
        +navbar-no-auth()
        .container.d-flex.justify-content-center.align-items-start.py-5(style="min-height: 100vh;")
            .card.login-card.shadow-lg
              .row.h-100

                // Imagen izquierda
                .col-lg-6.d-none.d-lg-block.p-0
                  img.login-image(
                    src="/images/login-fotaza.png"
                    alt="Fotografía artística"
                  )

                // Formulario
                .col-lg-6.bg-white.d-flex.align-items-center.justify-content-center

                    .form-side


                        h1.login-title.mb-2 Iniciar sesión

                        p.text-muted.mb-5
                          | Bienvenido nuevamente a Fotaza.

                        form(action="/auth/login" method="POST")

                          .mb-4
                            label.form-label Correo electrónico

                            input.form-control(
                              type="email"
                              name="email"
                              placeholder="ejemplo@email.com"
                              required
                            )

                          .mb-4
                            label.form-label Contraseña

                            input.form-control(
                              type="password"
                              name="password"
                              placeholder="••••••••"
                              required
                            )

                          button.btn.login-btn.w-100.mb-4(type="submit")
                            | Ingresar

                          .text-center
                            p.text-muted.mb-0
                              | ¿No tienes cuenta?
                              a.text-dark.fw-semibold.ms-1(href="/auth/signup") Registrarse
        +footer()
    script(src='/script/bootstrap.bundle.min.js') 